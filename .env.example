# Where Kavita answers, as seen from this app (a container name works when both share a network).
LOMBO_SAGA_KAVITA_URL=http://kavita:5000
# Kavita: your account settings, API key. Use an admin account.
LOMBO_SAGA_KAVITA_API_KEY=changeme
# Your rules (see rules.example.json). Read again every round.
LOMBO_SAGA_RULES_FILE=/config/rules.json
# true = a collection this app creates is made visible to everyone.
LOMBO_SAGA_PROMOTE=true
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_SAGA_WEBHOOK_URL=
# true = show what would be added and change nothing. Set false only after reading the output of `plan`.
LOMBO_SAGA_DRY_RUN=true
# Seconds between rounds when running with --loop. At least 60.
LOMBO_SAGA_INTERVAL_SECONDS=3600
